{
  "name": "likha-sis",
  "version": "0.2.0",
  "description": "LIKHA-SIS 0.2 - native-first, local-first, offline-capable SIS for Philippine DepEd schools",
  "repository": {
    "type": "git",
    "url": "https://github.com/312810-spec/likha-sis-0.2.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node node_modules/typescript-compiler/bin/tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node node_modules/typescript-compiler/bin/tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:dev-preview-isolation": "node scripts/check-dev-preview-isolation.mjs",
    "check:deadcode": "knip",
    "quality": "npm run typecheck && npm run lint && npm run format:check && npm run check:architecture && npm run check:deadcode && npm run test",
    "quality:security": "node scripts/check-security.mjs",
    "quality:ui": "node scripts/ui-smoke.mjs",
    "harness:verify": "node scripts/harness/verify.mjs",
    "quality:full": "npm run quality && cd src-tauri && cargo fmt --check && cargo test && cargo clippy --all-targets -- -D warnings",
    "quality:ui:recovery": "node scripts/ui-recovery.mjs"
  },
  "dependencies": {
    "@fontsource/public-sans": "5.3.0",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-dialog": "2.8.1",
    "@tauri-apps/plugin-opener": "2.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/cli": "0.1.22",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "knip": "6.39.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "typescript-compiler": "npm:typescript@7.0.2"
  }
}
